import tkinter as tk
from PIL import Image, ImageTk

# Create window
root = tk.Tk()
root.title("Importance of Safe Energy")
root.geometry("1200x700")
root.resizable(False, False)

# Load background image
image = Image.open("green_landscape.jpg")
image = image.resize((1200, 700))
background = ImageTk.PhotoImage(image)

# Background
bg_label = tk.Label(root, image=background)
bg_label.place(x=0, y=0, relwidth=1, relheight=1)

# Dark transparent-style overlay
overlay = tk.Frame(root, bg="#000000")
overlay.place(x=0, y=0, relwidth=1, relheight=1)

# Main title
title = tk.Label(
    root,
    text="IMPORTANCE OF\nSAFE ENERGY",
    font=("Arial", 42, "bold"),
    fg="white",
    bg="#000000"
)
title.place(relx=0.5, rely=0.38, anchor="center")

# Subtitle
subtitle = tk.Label(
    root,
    text="Powering a cleaner, safer and sustainable future",
    font=("Arial", 18),
    fg="white",
    bg="#000000"
)
subtitle.place(relx=0.5, rely=0.58, anchor="center")

# Button
start_button = tk.Button(
    root,
    text="EXPLORE",
    font=("Arial", 14, "bold"),
    fg="white",
    bg="#2E7D32",
    activebackground="#1B5E20",
    activeforeground="white",
    padx=35,
    pady=12,
    relief="flat",
    cursor="hand2"
)
start_button.place(relx=0.5, rely=0.70, anchor="center")

# Small footer
footer = tk.Label(
    root,
    text="Sustainable Energy • Environmental Safety • Future Innovation",
    font=("Arial", 11),
    fg="white",
    bg="#000000"
)
footer.place(relx=0.5, rely=0.92, anchor="center")

root.mainloop()
